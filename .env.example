# .env.example
# Database
# For production
POSTGRES_PASSWORD=your_secure_password_here
# For development (local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/askim_candles?schema=public"
# For production (Docker)
# DATABASE_URL=postgresql://askim_user:your_secure_password_here@postgres:5432/askim_candles_prod?schema=public

# NextAuth Configuration
# For development
NEXTAUTH_URL="http://localhost:9002"
# For production
# NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET="your_32_character_secret_here_generate_with_openssl"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application
NODE_ENV=development
PORT=9002

# Optional: Email Service
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password
EMAIL_FROM=noreply@askimcandles.com

# Optional: Image Storage (Cloudinary example)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Address API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key