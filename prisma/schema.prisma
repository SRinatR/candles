// prisma/schema.prisma
// Полная схема для e-commerce платформы Askim Candles

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли пользователей
enum UserRole {
  USER
  ADMIN
  MANAGER
}

// Статус пользователей
enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

// Статус заказов
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// Типы оплаты
enum PaymentType {
  CASH_ON_DELIVERY
  CARD
  OTHER
}

// Статус клиентов
enum ClientStatus {
  ACTIVE
  BLOCKED
}

// Пользователи (для сайта и админки)
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String?
  role        UserRole @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Дополнительные поля профиля
  emailVerified   Boolean?  @default(false)
  twoFactorEnabled Boolean  @default(false)
  isBlocked       Boolean   @default(false)
  lastLoginAt    DateTime?
  loginAttempts  Int       @default(0)
  
  // Контактная информация
  phone       String?
  avatar      String?
  
  // Рабочая информация
  department  String?
  position    String?
  
  // Связи
  orders      Order[]
  managers    Manager[]
  logs        Log[]
  sessions    UserSession[]
  managerProfile ManagerProfile?
  adminProfile   AdminProfile?
  productDrafts ProductDraft[]
  
  @@map("users")
}

// Категории товаров
model Category {
  id          Int       @id @default(autoincrement())
  name        Json
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Связи
  products     Product[]
  translations CategoryTranslation[]
  
  @@map("categories")
}

// Материалы
model Material {
  id        Int       @id @default(autoincrement())
  name      Json
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Связи
  products     Product[]
  translations MaterialTranslation[]
  
  @@map("materials")
}

// Ароматы
model Scent {
  id        Int       @id @default(autoincrement())
  name      Json
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Связи
  products     Product[]
  translations ScentTranslation[]
  
  @@map("scents")
}

// Продукты
model Product {
  id          Int      @id @default(autoincrement())
  name        Json
  description Json
  sku         String   @unique
  price       Int
  costPrice   Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  status      String   @default("ACTIVE")
  dimensions  String?
  burningTime String?
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Связи с категориями и атрибутами
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  
  scentId     Int?
  scent       Scent?   @relation(fields: [scentId], references: [id])
  
  materialId  Int?
  material    Material? @relation(fields: [materialId], references: [id])
  
  // Многоязычные поля (для совместимости)
  translations ProductTranslation[]
  
  // Изображения (для совместимости)
  productImages ProductImage[] @relation(name: "ProductImages")
  
  // Дополнительные атрибуты
  attributes  ProductAttribute[]
  
  @@map("products")
}

// Переводы продуктов
model ProductTranslation {
  id          String @id @default(cuid())
  productId   Int
  locale      String // 'en', 'ru', 'uz'
  name        String
  description String
  
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([productId, locale])
  @@map("product_translations")
}

// Изображения продуктов
model ProductImage {
  id        String  @id @default(cuid())
  productId Int
  url       String
  isMain    Boolean @default(false)
  order     Int     @default(0)
  
  product   Product @relation(name: "ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_images")
}

// Дополнительные атрибуты продуктов
model ProductAttribute {
  id        String @id @default(cuid())
  productId Int
  key       String
  value     String
  
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_attributes")
}

// Переводы категорий
model CategoryTranslation {
  id          String @id @default(cuid())
  categoryId  Int
  locale      String // 'en', 'ru', 'uz'
  name        String
  description String?
  
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([categoryId, locale])
  @@map("category_translations")
}

// Переводы материалов
model MaterialTranslation {
  id         String @id @default(cuid())
  materialId Int
  locale     String // 'en', 'ru', 'uz'
  name       String
  
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  
  @@unique([materialId, locale])
  @@map("material_translations")
}

// Переводы ароматов
model ScentTranslation {
  id      String @id @default(cuid())
  scentId Int
  locale  String // 'en', 'ru', 'uz'
  name    String
  
  scent   Scent @relation(fields: [scentId], references: [id], onDelete: Cascade)
  
  @@unique([scentId, locale])
  @@map("scent_translations")
}

// Статьи для раздела "Полезная информация"
model Article {
  id          String   @id @default(uuid())
  title       Json
  content     Json
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Многоязычные поля (для совместимости)
  translations ArticleTranslation[]
  
  @@map("articles")
}

// Переводы статей
model ArticleTranslation {
  id        String @id @default(cuid())
  articleId String
  locale    String // 'en', 'ru', 'uz'
  title     String
  content   String
  excerpt   String?
  
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@unique([articleId, locale])
  @@map("article_translations")
}

// Заказы
model Order {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  status      OrderStatus @default(PENDING)
  paymentType PaymentType @default(CASH_ON_DELIVERY)
  total       Int
  address     String
  items       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("orders")
}

// Клиенты
model Client {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("clients")
}

// Менеджеры (связь с User)
model Manager {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  role        UserRole @default(MANAGER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("managers")
}

// Логи
model Log {
  id          String   @id @default(uuid())
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  action      String
  meta        Json?
  createdAt   DateTime @default(now())
  
  @@map("logs")
}

// Скидки
model Discount {
  id          String   @id @default(uuid())
  code        String   @unique
  percent     Int
  active      Boolean  @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("discounts")
}

// Настройки
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
  
  @@map("settings")
}

// Сессии пользователей (refresh tokens, multi-device login)
model UserSession {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  refreshToken String  // Храним хэш refresh token
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  
  @@map("user_sessions")
}

// Профили менеджеров (role-specific fields)
model ManagerProfile {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  department String?
  hireDate   DateTime?
  // UI preferences
  theme     String?  @default("light") // "light" | "dark"
  language  String?  @default("en")    // "en" | "ru"
  
  @@map("manager_profiles")
}

// Профили админов (role-specific fields)
model AdminProfile {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  accessLevel String?
  // UI preferences
  theme     String?  @default("light") // "light" | "dark"
  language  String?  @default("en")    // "en" | "ru"
  
  @@map("admin_profiles")
}

// Черновики товаров
model ProductDraft {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  data        Json     // Все поля формы товара (draft)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("product_drafts")
}

// Логи администратора (совместимость с существующим кодом)
model AdminLog {
  id        String   @id @default(cuid())
  userId    String?  // ID пользователя, который выполнил действие
  userEmail String?  // Email пользователя
  userName  String?  // Имя пользователя
  action    String   // Описание действия
  details   String?  // Дополнительные детали в JSON формате
  ipAddress String?  // IP адрес
  userAgent String?  // User Agent браузера
  createdAt DateTime @default(now())
  
  @@map("admin_logs")
}