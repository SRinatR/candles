// prisma/schema.prisma
// Полная схема для e-commerce платформы Askim Candles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли пользователей
enum Role {
  ADMIN
  MANAGER
  USER
}

// Пользователи (для сайта и админки)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // Хешированный пароль (null для OAuth пользователей)
  role      Role     @default(USER)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

// Категории товаров
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Связи
  products     Product[]
  translations CategoryTranslation[]
  
  @@map("categories")
}

// Материалы
model Material {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Связи
  products     Product[]
  translations MaterialTranslation[]
  
  @@map("materials")
}

// Ароматы
model Scent {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Связи
  products     Product[]
  translations ScentTranslation[]
  
  @@map("scents")
}

// Продукты
model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  price       Float
  costPrice   Float?
  dimensions  String?
  burningTime String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Связи с категориями и атрибутами
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  
  scentId     String?
  scent       Scent?    @relation(fields: [scentId], references: [id])
  
  // Многоязычные поля
  translations ProductTranslation[]
  
  // Изображения
  images      ProductImage[]
  
  // Дополнительные атрибуты
  attributes  ProductAttribute[]
  
  @@map("products")
}

// Переводы продуктов
model ProductTranslation {
  id          String @id @default(cuid())
  productId   Int
  locale      String // 'en', 'ru', 'uz'
  name        String
  description String
  
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([productId, locale])
  @@map("product_translations")
}

// Изображения продуктов
model ProductImage {
  id        String  @id @default(cuid())
  productId Int
  url       String
  isMain    Boolean @default(false)
  order     Int     @default(0)
  
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_images")
}

// Дополнительные атрибуты продуктов
model ProductAttribute {
  id        String @id @default(cuid())
  productId Int
  key       String
  value     String
  
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_attributes")
}

// Переводы категорий
model CategoryTranslation {
  id          String @id @default(cuid())
  categoryId  String
  locale      String // 'en', 'ru', 'uz'
  name        String
  description String?
  
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([categoryId, locale])
  @@map("category_translations")
}

// Переводы материалов
model MaterialTranslation {
  id         String @id @default(cuid())
  materialId String
  locale     String // 'en', 'ru', 'uz'
  name       String
  
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  
  @@unique([materialId, locale])
  @@map("material_translations")
}

// Переводы ароматов
model ScentTranslation {
  id      String @id @default(cuid())
  scentId String
  locale  String // 'en', 'ru', 'uz'
  name    String
  
  scent   Scent @relation(fields: [scentId], references: [id], onDelete: Cascade)
  
  @@unique([scentId, locale])
  @@map("scent_translations")
}